# ─── Carol's Wellness Companion — Environment Variables ───

# PostgreSQL connection string. On Railway, add the Postgres plugin and
# reference its DATABASE_URL. Locally, point at your own Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/carol?schema=public"

# Server-side Venice AI API key. NEVER exposed to the browser — used only by
# the /api/chat route. Get one at https://venice.ai.
VENICE_API_KEY="your-venice-api-key"

# Optional: override the Venice model. Defaults to "llama-3.3-70b".
VENICE_MODEL="llama-3.3-70b"

# The single passcode Carol uses to log in (any string/PIN you like).
APP_PASSCODE="change-me"

# Optional: extra secret used to sign the session cookie. If unset, a secret is
# derived from APP_PASSCODE. Set this to a long random string in production.
SESSION_SECRET=""

# Optional: set to "true" to enable the in-app Demo Mode banner/seed helpers.
DEMO_MODE="false"
