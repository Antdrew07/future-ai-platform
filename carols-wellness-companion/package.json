{
  "name": "carols-wellness-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Carol's Wellness Companion — a personal health & peptide-tracking app.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start -p ${PORT:-3000}",
